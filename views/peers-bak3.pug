extends layout

block headContent
	title Peers

	link(rel="stylesheet", href=assetUrl("./style/dataTables.bootstrap4.min.css"), integrity= "", crossorigin="anonymous")
	link(rel="stylesheet", href=assetUrl("./leaflet/leaflet.css"), integrity= "", crossorigin="anonymous")

	//- Add flag icons CSS
	link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/flag-icon-css/4.1.6/css/flag-icon.min.css", crossorigin="anonymous")

	script(src=assetUrl("./leaflet/leaflet.js"), integrity= "", crossorigin="anonymous")

	style.
		.versions-hidden-rows, .services-hidden-rows {
			display: none;
		}
		#map {
			height: 0;
			transition: height 0.3s;
		}
		#map.active {
			height: 400px;
		}
		.flag-column {
			width: 140px;
		}
		.flag-container {
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}
		.dataTables_wrapper .dataTables_length,
		.dataTables_wrapper .dataTables_filter {
			margin-bottom: 0.5rem;
		}

		/* 🔥 Fix top spacing */
		.tab-content {
			margin-top: 0 !important;
			padding-top: 0 !important;
		}
		.page-title {
			margin-top: 0 !important;
			padding-top: 0 !important;
		}

		/* Debug styles */
		.debug-info {
			font-size: 0.75rem;
			color: #6c757d;
		}
		.country-debug {
			background-color: #fff3cd;
			border: 1px solid #ffeaa7;
			border-radius: 0.25rem;
			padding: 0.5rem;
			margin-bottom: 1rem;
		}
		.country-code-hover {
			cursor: help;
			border-bottom: 1px dotted #6c757d;
		}

block content
	+pageTitle(`${peerSummary.getpeerinfo.length} Peer${peerSummary.getpeerinfo.length == 1 ? "" : "s"}`)
	include ads.pug
	+pageTabs(["Details", "JSON", "Debug"])

	.tab-content
		+pageTab("Details", true)

			//- Only show map if at least one peer has valid geo coordinates
			- var hasGeoPeers = false;
			- var geoPeersCount = 0;
			- if (peerIpSummary && peerIpSummary.detailsByIp) {
			-   for (var key in peerIpSummary.detailsByIp) {
			-     if (peerIpSummary.detailsByIp[key].latitude && peerIpSummary.detailsByIp[key].longitude) {
			-       hasGeoPeers = true;
			-       geoPeersCount++;
			-     }
			-   }
			- }
			
			if hasGeoPeers
				+contentSection(`Peer Locations Map (${geoPeersCount} peers with location data)`)
					#map
					.small.text-muted.mt-2
						| Showing approximate locations for #{geoPeersCount} out of #{peerSummary.getpeerinfo.length} peers

			.row
				.col-md-6
					+contentSection("Top Versions")
						table.table.table-borderless.table-striped.table-responsive-sm
							thead
								tr
									th
									th.text-card-highlight.text-uppercase.fw-light Version
									th.text-end.text-card-highlight.text-uppercase.fw-light Count
							tbody
								each item, index in peerSummary.versionSummary
									tr(class=(index >= 5 ? "versions-hidden-rows" : false))
										td.small.text-muted #{index + 1}
										td #{item[0]}
										td.text-end #{item[1].toLocaleString()}

				.col-md-6
					+contentSection("Top Service Flags")
						table.table.table-borderless.table-striped.table-responsive-sm
							thead
								tr
									th
									th.text-card-highlight.text-uppercase.fw-light Services
									th.text-end.text-card-highlight.text-uppercase.fw-light Count
							tbody
								each item, index in peerSummary.servicesSummary
									tr(class=(index >= 5 ? "services-hidden-rows" : false))
										td.small.text-muted #{index + 1}
										td 
											if (!peerSummary.serviceNamesAvailable)
												| 0x
											| #{item[0].replace(/^0+/, '')}
										td.text-end #{item[1].toLocaleString()}

			if (peerSummary.networkTypeSummary || peerSummary.connectionTypeSummary)
				.row
					if (peerSummary.networkTypeSummary)
						.col-md-6
							+contentSection("Network Types")
								table.table.table-borderless.table-striped.table-responsive-sm
									thead
										tr
											th
											th.text-card-highlight.text-uppercase.fw-light Network Type
											th.text-end.text-card-highlight.text-uppercase.fw-light Count
									tbody
										each item, index in peerSummary.networkTypeSummary
											tr
												td.small.text-muted #{index + 1}
												td #{item[0]}
												td.text-end #{item[1].toLocaleString()}

					if (peerSummary.connectionTypeSummary)
						.col-md-6
							+contentSection("Connection Types")
								table.table.table-borderless.table-striped.table-responsive-sm
									thead
										tr
											th
											th.text-card-highlight.text-uppercase.fw-light Connection Type
											th.text-end.text-card-highlight.text-uppercase.fw-light Count
									tbody
										each item, index in peerSummary.connectionTypeSummary
											tr
												td.small.text-muted #{index + 1}
												td #{item[0]}
												td.text-end #{item[1].toLocaleString()}

			+contentSection(`${peerSummary.getpeerinfo.length.toLocaleString()} Peer${peerSummary.getpeerinfo.length == 1 ? "" : "s"}`)
				table.table.table-borderless.table-striped.table-responsive-sm.data-table.mt-4
					thead
						tr
							th
							th.text-card-highlight.text-uppercase.fw-light Version
							th.text-card-highlight.text-uppercase.fw-light Address
							th.text-card-highlight.text-uppercase.fw-light Country
							th.text-card-highlight.text-uppercase.fw-light Services
							th.text-card-highlight.text-uppercase.fw-light Conn. Type
							th.text-card-highlight.text-uppercase.fw-light Last Send / Receive

					tbody
						each item, index in peerSummary.getpeerinfo
							- var lastSendAgo = moment.duration(moment.utc(new Date()).diff(moment.utc(new Date(parseInt(item.lastsend) * 1000)))).format().replace("milliseconds", "ms");
							- var lastRecvAgo = moment.duration(moment.utc(new Date()).diff(moment.utc(new Date(parseInt(item.lastrecv) * 1000)))).format().replace("milliseconds", "ms");
							- var ipAddr = item.addr.substring(0, item.addr.lastIndexOf(":"));
							- ipAddr = ipAddr.replace(/,/g, '.');
							- var countryCode = null;
							- var countryName = null;
							- var city = null;
							- var region = null;
							- var hasGeoData = false;
							
							if (peerIpSummary && peerIpSummary.detailsByIp && peerIpSummary.detailsByIp[ipAddr])
								- var ipDetails = peerIpSummary.detailsByIp[ipAddr];
								- hasGeoData = true;
								
								//- Try multiple possible field names for country code
								- countryCode = ipDetails.country_code || ipDetails.countryCode || ipDetails.country;
								- countryName = ipDetails.country_name || ipDetails.countryName;
								
								//- Normalize country code to 2 letters if it exists
								if (countryCode && typeof countryCode === 'string')
									- countryCode = countryCode.toLowerCase().substring(0, 2);
								
								if (ipDetails.city)
									- city = ipDetails.city;
								if (ipDetails.region)
									- region = ipDetails.region;
								else if (ipDetails.region_name)
									- region = ipDetails.region_name;

							tr
								td.small.text-muted #{index + 1}
								td #{item.subver}
								td
									if (item.addr.length > 20)
										span.border-dotted(title=item.addr, data-bs-toggle="tooltip")
											| #{utils.ellipsizeMiddle(item.addr, 21)}
									else
										| #{item.addr}
								td.flag-column
									if (countryCode && countryCode.length === 2)
										- var locationParts = [];
										if (city) 
											- locationParts.push(city);
										if (region) 
											- locationParts.push(region);
										if (countryName) 
											- locationParts.push(countryName);
										- var tooltipText = locationParts.join(', ') || 'Unknown location';
										span.border-dotted(title=tooltipText, data-bs-toggle="tooltip")
											span.flag-container
												span(class=`flag-icon flag-icon-${countryCode}`)
												span.small #{countryCode.toUpperCase()}
									else if (countryName)
										span.border-dotted(title=countryName, data-bs-toggle="tooltip")
											span.flag-container
												span.small 🌐 #{countryName}
									else if (hasGeoData)
										span.border-dotted(title="Location data available but no country info", data-bs-toggle="tooltip")
											span.flag-container
												span.small.text-muted ?
									else
										span.border-dotted(title="No location data available", data-bs-toggle="tooltip")
											span.flag-container
												span.small.text-muted N/A

								td
									if (item.servicesnames)
										- var serviceItems = item.servicesnames;
										- var abbreviations = {"NETWORK":"NET", "NETWORK_LIMITED":"NET_LIM", "WITNESS":"WIT", "BLOOM":"BLM", "P2P_V2":"P2P_V2"};
										each itemAbbr, itemName in abbreviations
											if (item.servicesnames.includes(itemName))
												span(title=itemName, data-bs-toggle="tooltip")
													+darkBadge(itemAbbr)
									else
										| 0x#{item.services.replace(/^0+/, '')}
								td #{item.connection_type}
								td #{lastSendAgo} / #{lastRecvAgo}

		+pageTab("JSON")
			each item, index in peerSummary.getpeerinfo
				div.border-bottom.p-1
					a.me-2(href="javascript:void(0)" onclick=`$("#peerinfo_${index}").toggle(); $(this).find(".toggle-buttons").toggle();`)
						i.bi-plus-square.text-muted.toggle-buttons
						i.bi-dash-square.text-muted.toggle-buttons(style="display: none;")
					span #{item.addr}

				.p-3(style="display: none;", id=`peerinfo_${index}`)
					+contentSection("Peer Details")
						pre.mb-0
							code.json #{JSON.stringify(item, null, 4)}

					- var ipAddr = item.addr.substring(0, item.addr.lastIndexOf(":"));
					- ipAddr = ipAddr.replace(/,/g, '.');
					if (peerIpSummary && peerIpSummary.detailsByIp && peerIpSummary.detailsByIp[ipAddr])
						+contentSection("Location Info")
							pre.mb-0
								code.json #{JSON.stringify(peerIpSummary.detailsByIp[ipAddr], null, 4)}

		+pageTab("Debug")
			+contentSection("Country Data Debug")
				.row
					.col-md-6
						h6 IP Geolocation Summary
						table.table.table-sm
							tr
								td Total Peers:
								td #{peerSummary.getpeerinfo.length}
							tr
								td IPs with Geolocation Data:
								td #{(peerIpSummary && peerIpSummary.ips) ? peerIpSummary.ips.length : 0}
							tr
								td Peers with Valid Coordinates:
								td #{geoPeersCount}
							tr
								td Map API Key Available:
								td #{mapBoxComApiAccessKey ? 'Yes' : 'No'}

					.col-md-6
						h6 Sample IP Data (First 5)
						if (peerIpSummary && peerIpSummary.ips && peerIpSummary.ips.length > 0)
							each ip, idx in peerIpSummary.ips.slice(0, 5)
								- var details = peerIpSummary.detailsByIp[ip];
								.country-debug.mb-2
									strong #{ip}:
									pre.debug-info.mb-0 #{JSON.stringify(details, null, 2)}
						else
							p.text-muted No IP geolocation data available

			//- Initialize country data variables with safe defaults
			- var countryStats = {};
			- var countryFullNames = {};
			- var totalWithCountry = 0;
			
			if (peerIpSummary && peerIpSummary.detailsByIp && peerIpSummary.ips)
				each ip in peerIpSummary.ips
					- var details = peerIpSummary.detailsByIp[ip];
					if (details)
						- var code = details.country_code || details.countryCode || details.country;
						- var fullName = details.country_name || details.countryName;
						if (code)
							- totalWithCountry++;
							- countryStats[code] = (countryStats[code] || 0) + 1;
							if (fullName)
								- countryFullNames[code] = fullName;

			+contentSection("Country Code Analysis")
				.row
					.col-md-6
						h6 Country Distribution
						if (Object.keys(countryStats).length > 0)
							table.table.table-sm
								thead
									tr
										th Country Code
										th Count
								tbody
									each count, code in countryStats
										- var fullName = countryFullNames[code] || "Unknown country";
										tr
											td 
												span.country-code-hover(title=fullName, data-bs-toggle="tooltip") #{code}
											td #{count}
						else
							p.text-muted No country codes found in data
					.col-md-6
						h6 Statistics
						table.table.table-sm
							tr
								td IPs with any country data:
								td #{totalWithCountry}
							tr
								td Unique countries:
								td #{Object.keys(countryStats).length}
							tr
								td Valid 2-letter codes:
								td 
									- var validCodes = Object.keys(countryStats).filter(code => code && code.length === 2);
									| #{validCodes.length}
							tr
								td Countries with full names:
								td #{Object.keys(countryFullNames).length}

			+contentSection("Country Code Reference")
				.row
					.col-md-12
						h6 Common Country Codes and Full Names
						- var hasCountryData = countryStats && Object.keys(countryStats).length > 0;
						if (hasCountryData)
							.table-responsive
								table.table.table-sm.table-striped
									thead
										tr
											th Country Code
											th Full Country Name
											th Count
									tbody
										each count, code in countryStats
											- var fullName = (countryFullNames && countryFullNames[code]) || "Unknown country";
											tr
												td 
													strong #{code}
												td #{fullName}
												td #{count}
						else
							p.text-muted No country data available

block endOfBody
	script(src=assetUrl("./js/jquery.dataTables.min.js"), integrity= "", crossorigin="anonymous")
	script(src=assetUrl("./js/dataTables.bootstrap4.min.js"), integrity= "", crossorigin="anonymous")

	script.
		$(document).ready(function() {
			$('.data-table').DataTable({
				pageLength: 10,
				lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
				order: [[0, 'asc']],
				language: {
					search: "",
					searchPlaceholder: "Search"
				},
				dom: '<"d-flex justify-content-between align-items-center mb-3"<"d-flex align-items-center"l><"d-flex align-items-center"f>>t<"d-flex justify-content-between align-items-center mt-3"<"d-flex align-items-center"i><"d-flex align-items-center"p>>'
			});

			// Initialize tooltips
			$('[data-bs-toggle="tooltip"]').tooltip();
			
			// Initialize country code hover tooltips
			$('.country-code-hover').tooltip({
				trigger: 'hover',
				placement: 'top'
			});
		});

	if hasGeoPeers && (mapBoxComApiAccessKey != undefined)
		script.
			$(document).ready(function() {
				var mymap = L.map('map').setView([21.505, -0.09], 3);

				L.tileLayer('https://api.mapbox.com/styles/v1/{id}/tiles/{z}/{x}/{y}?access_token=!{mapBoxComApiAccessKey}', {
					maxZoom: 18,
					attribution: '© <a href="https://www.mapbox.com/about/maps/">Mapbox</a> ' +
						'© <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a> ' +
						'<strong><a href="https://www.mapbox.com/map-feedback/" target="_blank">Improve this map</a></strong> ' +
						'Imagery © <a href="https://www.mapbox.com/">Mapbox</a>',
					id: 'mapbox/streets-v11'
				}).addTo(mymap);

				// Add markers for peers with location data
				!{JSON.stringify(peerIpSummary.ips)}.forEach(function(ip) {
					var ipDetails = !{JSON.stringify(peerIpSummary.detailsByIp)};
					if (ipDetails[ip] && ipDetails[ip].latitude && ipDetails[ip].longitude) {
						var details = ipDetails[ip];
						var locationParts = [];
						if (details.city) locationParts.push(details.city);
						if (details.region_name) locationParts.push(details.region_name);
						else if (details.region) locationParts.push(details.region);
						if (details.country_name) locationParts.push(details.country_name);
						
						var locationText = locationParts.join(', ');
						var popupContent = "<b>" + ip + "</b><br>";
						if (locationText) popupContent += locationText;

						// Add flag if country code is available
						var countryCode = details.country_code || details.countryCode || details.country;
						if (countryCode && countryCode.length === 2) {
							popupContent = "<div style='display: flex; align-items: center; gap: 8px; margin-bottom: 8px;'>" +
								"<span class='flag-icon flag-icon-" + countryCode.toLowerCase() + "'></span>" +
								"<span><b>" + ip + "</b></span>" +
								"</div>" + locationText;
						}

						L.marker([details.latitude, details.longitude])
							.addTo(mymap)
							.bindPopup(popupContent);
					}
				});

				// Trigger resize after map is initialized
				setTimeout(function() {
					window.dispatchEvent(new Event('resize'));
					mymap.invalidateSize();
				}, 100);
			});